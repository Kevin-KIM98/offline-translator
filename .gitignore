!third_party/.gitkeep

# Model binaries never go in git
models/
*.bin
*.mlmodelc
*.spm

# IDE / OS
.vs/
.vscode/
.idea/
*.xcuserstate
xcuserdata/
.DS_Store
Thumbs.db

# Android
platform/android/.cxx/
platform/android/build/
platform/android/local.properties

# Python
__pycache__/
*.pyc
.venv/

# Desktop test model directories
pc-models/
pc-test/
pc-3b/

# Translation evaluation outputs
tests/eval/out/

# Desktop test model directories
pc-3b/
pc-upload/
